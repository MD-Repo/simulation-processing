{
  s_m_m2io_version
  :::
  2.0.0
}

f_m_ct {
  s_m_title
  s_ffio_ct_type
  :::
  "tiny - full system"
  full_system
  m_atom[8] {
    # This block is skipped: msys builds from the components #
    i_m_atomic_number
    r_m_x_coord
    r_m_y_coord
    r_m_z_coord
    :::
    1 6 99.0 99.0 99.0
    2 6 99.0 99.0 99.0
    3 8 99.0 99.0 99.0
    4 1 99.0 99.0 99.0
    5 1 99.0 99.0 99.0
    6 8 99.0 99.0 99.0
    7 1 99.0 99.0 99.0
    8 1 99.0 99.0 99.0
    :::
  }
}

f_m_ct {
  s_m_title
  s_ffio_ct_type
  r_chorus_box_ax
  r_chorus_box_ay
  r_chorus_box_az
  r_chorus_box_bx
  r_chorus_box_by
  r_chorus_box_bz
  r_chorus_box_cx
  r_chorus_box_cy
  r_chorus_box_cz
  :::
  "tiny ligand"
  solute
  50.0 0.0 0.0 0.0 50.0 0.0 0.0 0.0 50.0
  m_atom[2] {
    # First column is atom index #
    i_m_mmod_type
    r_m_x_coord
    r_m_y_coord
    r_m_z_coord
    i_m_residue_number
    s_m_insertion_code
    s_m_chain_name
    s_m_pdb_residue_name
    s_m_pdb_atom_name
    s_m_pdb_segment_name
    i_m_atomic_number  # a comment after a field name
    :::
    1 3 10.000000 10.000000 10.000000 1 " " "A" "LIG " " C1 " "LIG" 6
    2 3 11.500000 10.000000 10.000000 1 " " "A" <> " C2 " "LIG" 6
    :::
  }
  m_bond[2] {
    i_m_from
    i_m_to
    i_m_order
    :::
    1 1 2 1
    2 2 1 1
    :::
  }
  ffio_ff {
    s_ffio_name
    :::
    "tiny ff"
    ffio_sites[3] {
      s_ffio_type
      r_ffio_charge
      r_ffio_mass
      :::
      1 atom 0.0 12.0
      2 atom 0.0 12.0
      3 pseudo 0.0 0.0
      :::
    }
    ffio_pseudo[1] {
      r_ffio_x_coord
      r_ffio_y_coord
      r_ffio_z_coord
      s_ffio_atom_name
      i_ffio_residue_number
      s_ffio_pdb_residue_name
      s_ffio_chain_name
      s_ffio_pdb_segment_name
      :::
      1 10.500000 10.500000 10.000000 "V1" 1 "LIG " "A" "LIG"
      :::
    }
  }
}

f_m_ct {
  s_m_title
  s_ffio_ct_type
  :::
  "TIP4P water box"
  solvent
  m_atom[6] {
    i_m_mmod_type
    r_m_x_coord
    r_m_y_coord
    r_m_z_coord
    i_m_residue_number
    s_m_chain_name
    s_m_pdb_residue_name
    s_m_pdb_atom_name
    s_m_pdb_segment_name
    i_m_atomic_number
    :::
    1 16 20.000000 20.000000 20.000000 1 "W" "T4P " " O  " "WAT" 8
    2 42 20.960000 20.000000 20.000000 1 "W" "T4P " " H1 " "WAT" 1
    3 42 19.760000 20.930000 20.000000 1 "W" "T4P " " H2 " "WAT" 1
    4 16 30.000000 30.000000 30.000000 2 "W" "T4P " " O  " "WAT" 8
    5 42 30.960000 30.000000 30.000000 2 "W" "T4P " " H1 " "WAT" 1
    6 42 29.760000 30.930000 30.000000 2 "W" "T4P " " H2 " "WAT" 1
    :::
  }
  m_bond[4] {
    i_m_from
    i_m_to
    :::
    1 1 2
    2 1 3
    3 4 5
    4 4 6
    :::
  }
  ffio_ff {
    s_ffio_name
    :::
    "tip4p"
    ffio_sites[4] {
      s_ffio_type
      :::
      1 atom
      2 atom
      3 atom
      4 pseudo
      :::
    }
    ffio_pseudo[2] {
      r_ffio_x_coord
      r_ffio_y_coord
      r_ffio_z_coord
      s_ffio_atom_name
      i_ffio_residue_number
      s_ffio_pdb_residue_name
      s_ffio_chain_name
      s_ffio_pdb_segment_name
      :::
      1 20.100000 20.100000 20.000000 "M" 1 "T4P " "W" "WAT"
      2 30.100000 30.100000 30.000000 "M" 2 "T4P " "W" "WAT"
      :::
    }
  }
}
